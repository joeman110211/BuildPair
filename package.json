{
  "name": "buildpair",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run __tests__",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "build:web": "expo export --platform web",
    "serve:production": "node --env-file-if-exists=.env server.mjs",
    "serve:production:with-migrations": "npm run db:migrate && npm run serve:production",
    "verify:security-patches": "node scripts/verify-vendored-security.cjs"
  },
  "dependencies": {
    "@clerk/backend": "^2.0.0",
    "@clerk/expo": "^4.6.4",
    "@google/genai": "^1.32.0",
    "@neondatabase/serverless": "^1.0.2",
    "@stripe/connect-js": "^3.4.6",
    "@stripe/react-connect-js": "^3.4.4",
    "@stripe/stripe-react-native": "0.64.0",
    "braces": "file:packages/braces-security",
    "drizzle-orm": "^0.45.3",
    "expo": "~57.0.19",
    "expo-auth-session": "~57.0.14",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.4",
    "expo-server": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "node-forge": "file:packages/node-forge-security",
    "pg": "^8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.3",
    "stripe": "^19.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "~19.2.4",
    "decode-uri-component": "file:packages/decode-uri-component-bridge",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^4.0.9"
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "braces": "$braces",
    "node-forge": "$node-forge"
  }
}
