# Client-safe values
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=https://www.buildpair.co.uk
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only values
CLERK_SECRET_KEY=
DATABASE_URL=
# Optional for migrations/admin tooling; runtime uses DATABASE_URL.
DATABASE_URL_UNPOOLED=
STRIPE_SECRET_KEY=
STRIPE_BASIC_PRICE_ID=
STRIPE_FEATURED_PRICE_ID=
# Signing secret for platform-account events: subscriptions and PaymentIntents.
STRIPE_WEBHOOK_SECRET=
# Signing secret for the Connect destination that receives connected-account events.
STRIPE_CONNECT_WEBHOOK_SECRET=
# BuildPair service fee charged to the tradesperson on the accepted quote total excluding deposit stages.
PLATFORM_FEE_PERCENT=1
GEMINI_API_KEY=
# Hard application-wide ceiling for paid Gemini requests per rolling 24-hour bucket.
AI_GLOBAL_DAILY_LIMIT=200
RESEND_API_KEY=
INVOICE_FROM_EMAIL=BuildPair <info@buildpair.co.uk>
SUPPORT_EMAIL=info@buildpair.co.uk
APP_URL=https://www.buildpair.co.uk
ADMIN_CLERK_USER_IDS=
# Dedicated owner/admin web app hostname. The normal www host does not expose /admin.
BUILDPAIR_ADMIN_HOST=admin.buildpair.co.uk
# Used to protect maintenance endpoints when scheduled jobs are enabled on an always-on host.
CRON_SECRET=

# Explicitly opt in only on demo/preview environments. Keep false/blank for a real public marketplace.
BUILDPAIR_PREVIEW_DATA_ENABLED=false

# Set true on temporary/private hosts that must not be indexed by search engines.
BUILDPAIR_NOINDEX=false

# Cloudinary media storage
# BuildPair defaults to qrrcn7ma, so the cloud-name values are optional overrides.
CLOUDINARY_CLOUD_NAME=qrrcn7ma
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=qrrcn7ma
