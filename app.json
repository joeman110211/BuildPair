{
  "expo": {
    "name": "BuildPair",
    "slug": "buildpair",
    "version": "1.0.1",
    "icon": "https://res.cloudinary.com/qrrcn7ma/image/upload/c_crop,h_221,w_221,x_858,y_712/c_scale,w_1024/f_png/v1789145219/file_000000003d24820b9445ddc0225f908a.png",
    "orientation": "portrait",
    "scheme": "buildpair",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.co.buildpair.app",
      "buildNumber": "2",
      "icon": "https://res.cloudinary.com/qrrcn7ma/image/upload/c_crop,h_221,w_221,x_858,y_712/c_scale,w_1024/f_png/v1789145219/file_000000003d24820b9445ddc0225f908a.png"
    },
    "android": {
      "package": "uk.co.buildpair.app",
      "versionCode": 2,
      "icon": "https://res.cloudinary.com/qrrcn7ma/image/upload/c_crop,h_221,w_221,x_858,y_712/c_scale,w_1024/f_png/v1789145219/file_000000003d24820b9445ddc0225f908a.png"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "name": "BuildPair",
      "shortName": "BuildPair",
      "themeColor": "#D35400",
      "backgroundColor": "#ECEFF1"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://www.buildpair.co.uk"
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "https://res.cloudinary.com/qrrcn7ma/image/upload/c_crop,h_221,w_221,x_858,y_712/c_scale,w_1024/f_png/v1789145219/file_000000003d24820b9445ddc0225f908a.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 180
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.uk.co.buildpair.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BuildPair uses your photos to add job images and trade portfolio photos.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "2c528c36-07a7-4cad-b367-f23703f9cd47"
      }
    }
  }
}
